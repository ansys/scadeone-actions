inline function LimiterUnSymmetrical (lusInput: 'T;
                                      lowLimit: 'T;
                                      highLimit: 'T;)
  returns (lusOutput: 'T;)
  where 'T numeric
{
  diagram
    (assume $A1: lowLimit <= highLimit;
    #pragma diagram {"xy":"H66304;V19370","wh":"36000;3200"} #end)
    (#1 def lusOutput
    #pragma diagram {"xy":"H142927;V55695","wh":"14000;3200"} #end)
    (#2 expr highLimit
    #pragma diagram {"xy":"H54086;V32170","wh":"14000;3200"} #end)
    (#3 expr lowLimit
    #pragma diagram {"xy":"H53554;V44970","wh":"12000;3200"} #end)
    (#4 expr if #5 then #6 else #7
      where
        (#5 group)
        (#6 group)
        (#7 group)
    #pragma diagram {"xy":"H95300;V57595"} #end)
    (#8 expr if #9 then #10 else #11
      where
        (#9 group)
        (#10 group)
        (#11 group)
    #pragma diagram {"xy":"H124120;V55695"} #end)
    (#12 expr lusInput
    #pragma diagram {"xy":"H53086;V28370","wh":"12000;3200"} #end)
    (#13 expr #14 <= #15
      where
        (#14 group)
        (#15 group)
    #pragma diagram {"xy":"H81742;V43070"} #end)
    (#16 expr #17 >= #18
      where
        (#17 group)
        (#18 group)
    #pragma diagram {"xy":"H112640;V30270"} #end)

    (#19 wire #12 => #17, #14, #7
    #pragma diagram {"wp":"#12 h13472[#17, v12800[#14, v18325 #7]]"} #end)
    (#20 wire #3 => #6, #15
    #pragma diagram {"wp":"#3 h6668[v10725 #6, #15]"} #end)
    (#21 wire #8 => #1)
    (#22 wire #2 => #18, #10
    #pragma diagram {"wp":"#2 h44384[#18, v21625 #10]"} #end)
    (#23 wire #13 => #5
    #pragma diagram {"wp":"#13 h10058 #5"} #end)
    (#24 wire #16 => #9
    #pragma diagram {"wp":"#16 h7980 #9"} #end)
    (#25 wire #4 => #11)
}

