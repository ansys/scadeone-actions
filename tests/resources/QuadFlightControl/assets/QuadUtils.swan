      where
        (#4 group)
        (#5 group)
    #pragma diagram {"xy":"H-21850;V-4350"} #end)
    (#6 expr #7 + #8
      where
        (#7 group)
        (#8 group)
    #pragma diagram {"xy":"H-6750;V-11950"} #end)

    (#9 wire #1 => #4)
    (#10 wire #6 => #5, #0
    #pragma diagram {"wp":"#6 h3500[v12100 h-30100 v-2600 #5, #0]"} #end)
    (#11 wire #3 => #8
    #pragma diagram {"wp":"#3 h3550 v-5700 #8"} #end)
