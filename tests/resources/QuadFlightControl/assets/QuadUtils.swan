node Integrator (i: 'T;
                 x : 'T;)
  returns (y: 'T;)
  where 'T numeric
{
  diagram
    (#0 def y
    #pragma diagram {"xy":"H8950;V-11950"} #end)
    (#1 expr i
    #pragma diagram {"xy":"H-38350;V-6250"} #end)
