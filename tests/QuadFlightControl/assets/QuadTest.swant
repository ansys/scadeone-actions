_harness TestVerticalAccel
{
  diagram
    (#0 block (Sources::Ramp \ amplitude: 0.1, cycles: 20_ui32, offset: 0.0)
              #pragma diagram {"xy":"H102636;V-41650","wh":"20000;14000"} #end)
    (#1 #pragma swt under_test #end block (Q::QuadFlightControl \ isReset: false, motorStates: (
                                              frontLeftFaulty: false,
                                              frontRightFaulty: false,
                                              rearLeftFaulty: false,
                                              rearRightFaulty: false
                                            ), desiredAttitude: ZERO_ATTITUDE, currentAttitude: ZERO_ATTITUDE)
                                          #pragma diagram {"xy":"H147454;V-41650","wh":"28387;21906"} #end)
    (#3 expr _current_cycle = 20
    #pragma diagram {"xy":"H122975;V-61825","wh":"22752;3200"} #end)
    (#4 def _stop_condition
    #pragma diagram {"xy":"H163288;V-61825","wh":"18064;3200"} #end)
    (#6 expr #8.(frontRightRotor)
      where
        (#8 group)
    #pragma diagram {"xy":"H187498;V-41650","wh":"26000;7000"} #end)
    (#7 block (_oracle SimVerticalAccelOracle)
    #pragma diagram {"xy":"H221148;V-41650","wh":"12000;14000"} #end)

    (#2 wire #0 => #1 .(desiredVerticalAccel)
    #pragma diagram {"wp":"v0|#0 #1"} #end)
    (#5 wire #3 => #4)
    (#9 wire #6 => #7 .(frontRightRotor))
    (#10 wire #1 .(rotorCmd) => #8
    #pragma diagram {"wp":"v0|#1 #8"} #end)
}

