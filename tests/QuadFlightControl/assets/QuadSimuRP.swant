-- version swan: 2025.1 graph: 2.0 swant: 1.1
use QuadFlightControl as Q;

use VTOLDisplay as VTOL;

use ControlPanel as RapidProto;

use QuadTypes as T;

function MotorHealthToMotorHealth (i0: T::MotorHealth;)
  returns (o0: VTOL::TMotorHealth;)
{
  diagram
    (#0 expr i0
    #pragma diagram {"xy":"H-92876;V-19525"} #end)
    (#1 expr
      (case #2 of
        | T::NOMINAL : #3
        | T::ABNORMAL : #4
        | T::FAILURE : #5)
          where
            (#2 group)
            (#3 group)
            (#4 group)
            (#5 group)
        #pragma diagram {"xy":"H-70876;V-9225","wh":"16000;14600"} #end)
    (#6 def o0
    #pragma diagram {"xy":"H-48876;V-11125"} #end)
    (#7 expr VTOL::NOMINAL
    #pragma diagram {"xy":"H-96970;V-11125","wh":"16189;3200"} #end)
    (#8 expr VTOL::ABNORMAL
    #pragma diagram {"xy":"H-97439;V-7325","wh":"17126;3200"} #end)
    (#9 expr VTOL::FAILURE
    #pragma diagram {"xy":"H-96970;V-3525","wh":"16189;3200"} #end)
    
    (#10 wire #0 => #2
    #pragma diagram {"wp":"#0 h19500 #2"} #end)
    (#11 wire #1 => #6)
    (#12 wire #7 => #3)
    (#13 wire #8 => #4)
    (#14 wire #9 => #5)
}

_harness SimuPanels
{
  diagram
    (#0 #pragma swt under_test #end block (Q::QuadFlightControl \ isReset: false, currentAttitude: ZERO_ATTITUDE)
                                          #pragma diagram {"xy":"H34144;V-222148","wh":"55925;78426"} #end)
    (#1 block VTOL::VTOLDisplay
              #pragma diagram {"xy":"H221731;V-218694","wh":"20000;111762"} #end)
    (#3 expr {#9}: T::AttitudeType
      where
        (#9 group)
    #pragma diagram {"xy":"H-29169;V-219481","wh":"16000;10000"} #end)
    (#10 group
    #pragma diagram {"xy":"H105469;V-237067","wh":"500;45075"} #end)
    (#34 block RapidProto::ControlPanel
               #pragma diagram {"xy":"H-76256;V-229688","wh":"43300;41100"} #end)
    (#2 group
    #pragma diagram {"xy":"H165756;V-183639","wh":"500;14000"} #end)
    (#14 block MotorHealthToMotorHealth
               #pragma diagram {"xy":"H148781;V-231194","wh":"34450;14500"} #end)
    (#11 block MotorHealthToMotorHealth
               #pragma diagram {"xy":"H148781;V-246194","wh":"34450;14500"} #end)
    (#12 block MotorHealthToMotorHealth
               #pragma diagram {"xy":"H148781;V-260672","wh":"34450;13455"} #end)
    (#13 block MotorHealthToMotorHealth
               #pragma diagram {"xy":"H148781;V-216194","wh":"34450;14500"} #end)
    
    (#35 wire #34 .(thrust) => #0 .(desiredVerticalAccel)
    #pragma diagram {"wp":"v-3732|#34 #0"} #end)
    (#24 wire #0 .(motorHealthState) => #10
    #pragma diagram {"wp":"v-14919|#0 #10"} #end)
    (#36 wire #34 .(targetPitch) => #9 .(pitch)
    #pragma diagram {"wp":"v12874|#34 #9"} #end)
    (#37 wire #3 => #0 .(desiredAttitude))
    (#38 wire #34 .(targetYaw) => #9 .(yaw)
    #pragma diagram {"wp":"v10207|#34 #9"} #end)
    (#39 wire #34 .(targetRoll) => #9 .(roll)
    #pragma diagram {"wp":"v7540|#34 #9"} #end)
    (#15 wire #10 .(frontRight) => #12
    #pragma diagram {"wp":"v-19707|#10 #12"} #end)
    (#16 wire #10 .(frontLeft) => #11
    #pragma diagram {"wp":"v-9127|#10 #11"} #end)
    (#21 wire #10 .(rearRight) => #13
    #pragma diagram {"wp":"v18080|#10 #13"} #end)
    (#4 wire #34 .(failureFrontLeft: frontLeftFaulty, 
failureRearLeft: rearLeftFaulty, 
failureFrontRight: frontRightFaulty, 
failureRearRight: rearRightFaulty) => #0 .(motorStates)
    #pragma diagram {"wp":"v-14278|#34 #0"} #end)
    (#5 wire #2 .(frontRightRotor) => #1 .(motorFrontRight)
    #pragma diagram {"wp":"v4500|#2 #1"} #end)
    (#6 wire #0 .(rotorCmd) => #2
    #pragma diagram {"wp":"v35361|#0 #2"} #end)
    (#7 wire #2 .(frontLeftRotor) => #1 .(motorFrontLeft)
    #pragma diagram {"wp":"v1500|#2 #1"} #end)
    (#8 wire #2 .(rearLeftRotor) => #1 .(motorRearLeft)
    #pragma diagram {"wp":"v-1500|#2 #1"} #end)
    (#23 wire #2 .(rearRightRotor) => #1 .(motorRearRight)
    #pragma diagram {"wp":"v-4500|#2 #1"} #end)
    (#19 wire #14 => #1 .(rearLeftMotorHealth)
    #pragma diagram {"wp":"v0|#14 #1"} #end)
    (#22 wire #10 .(rearLeft) => #14
    #pragma diagram {"wp":"v5873|#10 #14"} #end)
    (#17 wire #11 => #1 .(frontLeftMotorHealth)
    #pragma diagram {"wp":"v0|#11 #1"} #end)
    (#18 wire #12 => #1 .(frontRightMotorHealth)
    #pragma diagram {"wp":"v0|#12 #1"} #end)
    (#20 wire #13 => #1 .(rearRightMotorHealth)
    #pragma diagram {"wp":"v0|#13 #1"} #end)
}

const ZERO_ATTITUDE = {
  pitch: 0.0, 
  roll: 0.0, 
  yaw: 0.0
}: T::AttitudeType;
